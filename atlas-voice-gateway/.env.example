# Atlas Voice Gateway - example environment file
#
# Copy to /etc/atlas-voice-gateway/atlas-voice-gateway.env (or a similar
# root-owned path) and edit for the machine. NEVER commit real values with
# secrets. This phase has no secrets; only addresses and tuning values.
#
#   cp .env.example /etc/atlas-voice-gateway/atlas-voice-gateway.env
#
# Verify every value against the live machine before enabling the service.

# --- Listening -------------------------------------------------------------
# Bind to the minimum necessary interface. Use the LAN or Tailscale address
# only if the browser must reach the gateway directly.
ATLAS_VOICE_GATEWAY_HOST=127.0.0.1
# Choose a port that is actually free on HAL (verify with `ss -ltnp`).
ATLAS_VOICE_GATEWAY_PORT=8787

# --- Ollama endpoints ------------------------------------------------------
# The gateway runs ON HAL, so HAL's Ollama is local.
HAL_OLLAMA_URL=http://127.0.0.1:11434
# TRON's Ollama API (LAN address as provided). Override if using Tailscale.
TRON_OLLAMA_URL=http://192.168.1.169:11434

# --- Models ----------------------------------------------------------------
# Leave empty to let the gateway pick the first model reported by Ollama.
# If set and the model is NOT installed, the agent reports "degraded" and
# will not be routed to - the gateway never assumes a model exists.
HAL_DEFAULT_MODEL=
TRON_DEFAULT_MODEL=

# --- Timing ----------------------------------------------------------------
REQUEST_TIMEOUT_MS=120000
OLLAMA_HEALTH_INTERVAL_MS=15000
ATLAS_HEARTBEAT_INTERVAL_MS=15000

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. No wildcard by default.
# Example: https://your-preview-domain , http://localhost:5173
ATLAS_ALLOWED_ORIGINS=

# --- Limits ----------------------------------------------------------------
ATLAS_MAX_MESSAGE_CHARS=8000
ATLAS_MAX_CONCURRENT_PER_AGENT=2
ATLAS_MAX_CONCURRENT_TOTAL=4

# --- Speech-to-text (faster-whisper) ---------------------------------------
# Toggle local STT. When off, /api/transcribe and /api/voice return 503 and the
# gateway runs text-only.
STT_ENABLED=true

# Model + device. medium.en balances latency/accuracy on the RTX A2000.
# If the configured model is unsuitable for available VRAM, change STT_MODEL.
#   STT_DEVICE=cuda  requires a CUDA build of torch (verify `nvidia-smi`).
STT_MODEL=medium.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# Fallback used only if GPU init fails AND STT_ALLOW_CPU_FALLBACK=true.
# CPU transcription is much slower; the service reports "degraded".
STT_CPU_COMPUTE_TYPE=int8
STT_ALLOW_CPU_FALLBACK=true

# Language. English by default. Set STT_AUTO_DETECT_LANGUAGE=true to let
# faster-whisper detect the language instead of forcing STT_LANGUAGE.
STT_LANGUAGE=en
STT_AUTO_DETECT_LANGUAGE=false

# Decoding / VAD. Keep VAD conservative so quiet speech is not clipped.
STT_BEAM_SIZE=5
STT_VAD=true

# Audio screening.
STT_MIN_AUDIO_MS=300
# Near-silence RMS threshold on 16-bit PCM. Lower = more permissive.
STT_SILENCE_RMS=80

# Upload / duration limits.
STT_MAX_UPLOAD_MB=25
STT_MAX_DURATION_S=120

# Transcription timeout (per clip) and concurrency guard.
STT_TIMEOUT_MS=60000
STT_MAX_CONCURRENCY=1

# Runtime temp directory for uploaded/converted audio. Leave empty to use the
# system temp dir. Files are always deleted after processing.
STT_TEMP_DIR=

# --- Text-to-speech (Piper) ------------------------------------------------
# Toggle local TTS. When off, /api/speech returns 503 and the voice flow still
# returns the text answer (no audio). The gateway never calls a cloud voice API.
TTS_ENABLED=true
TTS_ENGINE=piper

# Device for synthesis. Deliberately CPU by default: Piper is CPU-friendly and
# must not fight faster-whisper / Ollama for the RTX A2000. Set to "cuda" only
# if you intentionally want GPU synthesis (requires an onnxruntime-gpu build).
TTS_DEVICE=cpu

# Where the Piper .onnx voice models live. Bare voice names below are resolved
# as <TTS_VOICES_DIR>/<name>.onnx. Absolute paths are also accepted.
TTS_VOICES_DIR=

# Voice identities. Two genuinely distinct en-GB voices:
#   HAL  = en_GB-alan-medium  (calm, measured, deeper)
#   TRON = en_GB-cori-high    (clear, technical, brighter / slightly faster)
# Length scale > 1.0 is slower/more measured, < 1.0 is faster.
TTS_HAL_VOICE=en_GB-alan-medium
TTS_TRON_VOICE=en_GB-cori-high
TTS_HAL_LENGTH_SCALE=1.08
TTS_TRON_LENGTH_SCALE=0.97
TTS_HAL_VOLUME=1.0
TTS_TRON_VOLUME=1.0

# Upper bound on spoken characters (code is stripped, then the text is capped).
TTS_MAX_CHARS=1200

# Per-clip synthesis timeout and concurrency guard (reject with 429 tts_busy).
TTS_TIMEOUT_MS=20000
TTS_MAX_CONCURRENCY=1

# Short-lived synthesized-audio resource TTL (seconds). Audio lives only in
# memory and is never written to disk or retained permanently.
TTS_AUDIO_TTL_S=30